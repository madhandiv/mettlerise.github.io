---
import { siteConfig } from '../config';
---

<footer class="footer footer-center p-10 bg-base-200 text-base-content rounded">
  <nav class="grid grid-flow-col gap-4">
    <a href="/" class="link link-hover">Home</a>
    <a href="/training" class="link link-hover">Training</a>
    <a href="/about" class="link link-hover">About Us</a>
  </nav>
  <nav>
    <div class="grid grid-flow-col gap-4">
      <a href={siteConfig.founder.linkedin} target="_blank" rel="noopener noreferrer" class="link link-hover">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="fill-current">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
      </a>
      <a href={`mailto:${siteConfig.company.email}`} class="link link-hover">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="fill-current">
          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
      </a>
    </div>
  </nav>
  <aside>
    <p class="font-bold">{siteConfig.company.name}</p>
    <p>{siteConfig.company.tagline}</p>
    <p>{siteConfig.company.location}</p>
    <p class="text-sm mt-2">© {new Date().getFullYear()} - All rights reserved</p>
  </aside>
</footer>
