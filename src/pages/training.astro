---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import { getCollection } from 'astro:content';

const allCourses = (await getCollection('courses'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`Training Courses - ${siteConfig.company.name}`}>
  <div class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-800 py-16">
    <div class="container mx-auto px-4 text-center text-white">
      <h1 class="text-5xl font-bold mb-4">Training Courses</h1>
      <p class="text-xl max-w-3xl mx-auto">
        Launch your tech career with our comprehensive, industry-aligned training programs.
        Learn from experienced professionals and work on real-world projects.
      </p>
    </div>
  </div>

  <section class="py-16 bg-base-100">
    <div class="container mx-auto px-4">
      <div class="stats shadow w-full grid grid-cols-1 md:grid-cols-3 mb-12">
        <div class="stat">
          <div class="stat-figure text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="stat-title">Industry-Ready</div>
          <div class="stat-value text-primary">100%</div>
          <div class="stat-desc">Curriculum aligned with industry needs</div>
        </div>

        <div class="stat">
          <div class="stat-figure text-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
          </div>
          <div class="stat-title">Hands-on Projects</div>
          <div class="stat-value text-secondary">50%</div>
          <div class="stat-desc">Practical learning with real projects</div>
        </div>

        <div class="stat">
          <div class="stat-figure text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <div class="stat-title">Placement Support</div>
          <div class="stat-value text-accent">Yes</div>
          <div class="stat-desc">Career guidance and interview prep</div>
        </div>
      </div>

      <div class="mb-8">
        <h2 class="text-3xl font-bold mb-6">All Courses ({allCourses.length})</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allCourses.map(course => (
          <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-2 border border-base-300">
            <div class="card-body">
              <div class="flex items-start justify-between">
                <div class="badge badge-primary">{course.data.level}</div>
                {course.data.featured && (
                  <div class="badge badge-secondary">Featured</div>
                )}
              </div>

              <h3 class="card-title text-xl mt-2">{course.data.title}</h3>
              <p class="text-base-content/70 line-clamp-3">{course.data.description}</p>

              <div class="divider my-2"></div>

              <div class="space-y-2 text-sm">
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span><strong>Duration:</strong> {course.data.duration}</span>
                </div>

                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span><strong>Schedule:</strong> {course.data.schedule}</span>
                </div>

                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="font-semibold text-success text-base">{course.data.fees}</span>
                </div>
              </div>

              <div class="mt-4">
                <p class="text-xs font-semibold mb-2">Technologies:</p>
                <div class="flex flex-wrap gap-1">
                  {course.data.technologies.map(tech => (
                    <span class="badge badge-sm badge-outline">{tech}</span>
                  ))}
                </div>
              </div>

              <div class="card-actions justify-between items-center mt-4 pt-4 border-t border-base-300">
                <a href={`/training/${course.slug}`} class="btn btn-primary btn-sm">
                  View Details
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <a href={`mailto:${siteConfig.company.email}?subject=Inquiry about ${course.data.title}`} class="btn btn-ghost btn-sm">
                  Enroll Now
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-8">Why Choose Our Training Programs?</h2>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-primary-content">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-lg mb-2">Expert Instructors</h3>
              <p class="text-base-content/70">Learn from industry professionals with years of real-world experience.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center text-secondary-content">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-lg mb-2">Comprehensive Curriculum</h3>
              <p class="text-base-content/70">Structured learning paths covering fundamentals to advanced concepts.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-accent flex items-center justify-center text-accent-content">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-lg mb-2">Hands-on Projects</h3>
              <p class="text-base-content/70">Build real-world projects to strengthen your portfolio.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 rounded-full bg-success flex items-center justify-center text-success-content">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
            <div>
              <h3 class="font-bold text-lg mb-2">Career Support</h3>
              <p class="text-base-content/70">Interview preparation and placement assistance to kickstart your career.</p>
            </div>
          </div>
        </div>

        <div class="text-center mt-12">
          <a href={`mailto:${siteConfig.company.email}`} class="btn btn-primary btn-lg">
            Get Started Today
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
