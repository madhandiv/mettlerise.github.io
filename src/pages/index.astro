---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
import { getCollection } from 'astro:content';

const featuredCourses = (await getCollection('courses'))
  .filter(course => course.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout>
  <div class="hero min-h-[70vh] bg-gradient-to-br from-slate-900 via-blue-900 to-slate-800">
    <div class="hero-content text-center text-white">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-bold mb-6">{siteConfig.company.name}</h1>
        <p class="text-2xl mb-4">{siteConfig.company.tagline}</p>
        <p class="text-lg mb-8">
          Professional software development and consulting services combined with
          comprehensive training programs for the next generation of tech talent.
        </p>
        <div class="flex gap-4 justify-center">
          <a href="/training" class="btn btn-lg bg-teal-500 hover:bg-teal-600 text-white border-0">Explore Courses</a>
          <a href={siteConfig.founder.linkedin} target="_blank" class="btn btn-lg btn-outline border-white text-white hover:bg-white hover:text-slate-900">
            Connect on LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>

  <section class="py-20 bg-base-100">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-12">Our Services</h2>
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="card bg-base-200 shadow-xl hover:shadow-2xl transition-shadow">
          <div class="card-body">
            <h3 class="card-title text-2xl">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
              {siteConfig.services.development.title}
            </h3>
            <p class="text-base-content/80">{siteConfig.services.development.description}</p>
            <ul class="mt-4 space-y-2">
              {siteConfig.services.development.features.map(feature => (
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="card bg-base-200 shadow-xl hover:shadow-2xl transition-shadow">
          <div class="card-body">
            <h3 class="card-title text-2xl">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
              </svg>
              {siteConfig.services.training.title}
            </h3>
            <p class="text-base-content/80">{siteConfig.services.training.description}</p>
            <ul class="mt-4 space-y-2">
              {siteConfig.services.training.features.map(feature => (
                <li class="flex items-start gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success mt-0.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-base-200">
    <div class="container mx-auto px-4">
      <h2 class="text-4xl font-bold text-center mb-4">Featured Training Courses</h2>
      <p class="text-center text-base-content/70 mb-12 max-w-2xl mx-auto">
        Industry-relevant courses designed to make you job-ready. Learn from experienced professionals.
      </p>
      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {featuredCourses.map(course => (
          <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-2">
            <div class="card-body">
              <div class="badge badge-primary">{course.data.level}</div>
              <h3 class="card-title text-xl mt-2">{course.data.title}</h3>
              <p class="text-base-content/70">{course.data.description}</p>
              <div class="divider my-2"></div>
              <div class="space-y-2 text-sm">
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{course.data.duration}</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="font-semibold">{course.data.fees}</span>
                </div>
              </div>
              <div class="flex flex-wrap gap-1 mt-3">
                {course.data.technologies.slice(0, 3).map(tech => (
                  <span class="badge badge-sm badge-outline">{tech}</span>
                ))}
                {course.data.technologies.length > 3 && (
                  <span class="badge badge-sm badge-outline">+{course.data.technologies.length - 3}</span>
                )}
              </div>
              <div class="card-actions justify-end mt-4">
                <a href={`/training/${course.slug}`} class="btn btn-primary btn-sm">Learn More</a>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/training" class="btn btn-primary btn-lg">View All Courses</a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-base-100">
    <div class="container mx-auto px-4 text-center">
      <h2 class="text-4xl font-bold mb-6">Ready to Transform Your Career?</h2>
      <p class="text-lg mb-8 max-w-2xl mx-auto">
        Join hundreds of students who have successfully launched their tech careers with {siteConfig.company.name}.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/training" class="btn btn-primary btn-lg">Browse Courses</a>
        <a href="/about" class="btn btn-outline btn-lg">About Us</a>
        <a href={`mailto:${siteConfig.company.email}`} class="btn btn-outline btn-lg">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
